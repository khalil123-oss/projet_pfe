pipeline {
    agent any

    environment {
        REGISTRY     = "registry.gitlab.com"
        PROJECT      = "knemsia/projet_pfe"
        BACKEND_IMG  = "${REGISTRY}/${PROJECT}/backend"
        FRONTEND_IMG = "${REGISTRY}/${PROJECT}/frontend"
        HELM_RELEASE = "topnet"
        HELM_NS      = "topnet"
    }

    stages {

        stage('Clone') {
            steps {
                git credentialsId: 'gitlab-credentials',
                    url: 'https://gitlab.com/knemsia/projet_pfe.git',
                    branch: 'master'
            }
        }

        stage('Test Backend') {
            steps {
                sh '''
                    docker run --rm \
                      -v $(pwd)/Backend/TOPNET_PROJECT:/app \
                      -w /app \
                      python:3.14-slim \
                      sh -c "pip install -r requirements.txt -q && python manage.py check"
                '''
            }
        }

        stage('Build Images') {
            steps {
                sh "docker build -t ${BACKEND_IMG}:${BUILD_NUMBER} -t ${BACKEND_IMG}:latest Backend/TOPNET_PROJECT/"
                sh "docker build -t ${FRONTEND_IMG}:${BUILD_NUMBER} -t ${FRONTEND_IMG}:latest FRontend/"
            }
        }

        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'gitlab-registry',
                    usernameVariable: 'REG_USER',
                    passwordVariable: 'REG_PASS'
                )]) {
                    sh "echo $REG_PASS | docker login ${REGISTRY} -u $REG_USER --password-stdin"
                    sh "docker push ${BACKEND_IMG}:${BUILD_NUMBER}"
                    sh "docker push ${BACKEND_IMG}:latest"
                    sh "docker push ${FRONTEND_IMG}:${BUILD_NUMBER}"
                    sh "docker push ${FRONTEND_IMG}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(
                    credentialsId: 'kubeconfig-minikube',
                    variable: 'KUBECONFIG'
                )]) {
                    sh """
                        helm upgrade --install ${HELM_RELEASE} ./Topnet-chart \
                          --namespace ${HELM_NS} \
                          --create-namespace \
                          --set image.backend=${BACKEND_IMG}:${BUILD_NUMBER} \
                          --set image.frontend=${FRONTEND_IMG}:${BUILD_NUMBER} \
                          --set image.pullPolicy=Always \
                          --kubeconfig \$KUBECONFIG \
                          --wait --timeout 5m
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([file(
                    credentialsId: 'kubeconfig-minikube',
                    variable: 'KUBECONFIG'
                )]) {
                    sh "kubectl get pods -n ${HELM_NS} --kubeconfig \$KUBECONFIG"
                }
            }
        }
    }

    post {
        success { echo 'Pipeline reussi !' }
        failure { echo 'Pipeline echoue !' }
    }
}